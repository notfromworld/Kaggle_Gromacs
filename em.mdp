; ============================================================
; Energy Minimization
; Kaggle_Gromacs
; ============================================================

integrator      = steep
emtol           = 1000.0
emstep          = 0.01
nsteps          = 50000

; Neighbor searching
nstlist         = 20
cutoff-scheme   = Verlet

; Electrostatics / VdW
coulombtype     = PME
rcoulomb        = 1.0
vdwtype         = Cut-off
rvdw            = 1.0

; Periodic boundary conditions
pbc             = xyz

; Output
nstenergy       = 100
energygrps      = System
