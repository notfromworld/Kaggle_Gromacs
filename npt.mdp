; ============================================================
; NPT Equilibration
; Kaggle_Gromacs
; ============================================================

title           = NPT Equilibration

define          = -DPOSRES

integrator      = md
dt              = 0.002
nsteps          = 50000

; Output
nstxout         = 5000
nstvout         = 5000
nstenergy       = 1000
nstlog          = 1000

; Neighbor searching
cutoff-scheme   = Verlet
nstlist         = 20

; Electrostatics / VdW
coulombtype     = PME
rcoulomb        = 1.0
vdwtype         = Cut-off
rvdw            = 1.0

; Periodic boundary conditions
pbc             = xyz

; Temperature coupling
tcoupl          = V-rescale
tc-grps         = Protein Non-Protein
tau_t           = 0.1 0.1
ref_t           = 300 300

; Pressure coupling
pcoupl          = Berendsen
pcoupltype      = isotropic
tau_p           = 2.0
ref_p           = 1.0
compressibility = 4.5e-5

; Constraints
constraints     = h-bonds
constraint_algorithm = lincs

; Continuation
continuation    = yes

; Velocity generation
gen_vel         = no

; Center of mass
nstcomm         = 100
