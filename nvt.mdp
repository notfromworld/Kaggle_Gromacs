; ============================================================
; NVT Equilibration
; Kaggle_Gromacs
; ============================================================

title           = NVT Equilibration

define          = -DPOSRES

integrator      = md
dt              = 0.002
nsteps          = 50000

; Output
nstxout         = 5000
nstvout         = 5000
nstenergy       = 1000
nstlog          = 1000

; Neighbor searching
cutoff-scheme   = Verlet
nstlist         = 20

; Electrostatics / VdW
coulombtype     = PME
rcoulomb        = 1.0
vdwtype         = Cut-off
rvdw            = 1.0

; Periodic boundary conditions
pbc             = xyz

; Temperature coupling
tcoupl          = V-rescale
tc-grps         = Protein Non-Protein
tau_t           = 0.1 0.1
ref_t           = 300 300

; Pressure coupling
pcoupl          = no

; Constraints
constraints     = h-bonds
constraint_algorithm = lincs

; Velocity generation
gen_vel         = yes
gen_temp        = 300
gen_seed        = -1

; Center of mass
nstcomm         = 100
